# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=production
# >= 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
ALLOWED_ORIGINS=https://backfire.example.org
COOKIE_SECURE=true
CONTACT_EMAIL=you@your-institution.org

# Public WebSocket base when the API is served on its own domain, e.g. wss://api.backfire.example.org
# Leave empty when the API is routed on the same domain (recommended: route /api/* to the backend).
NEXT_PUBLIC_WS_URL=

# Demo mode: seeds an admin demo account and enables the one-click "Demo login" button.
# Off by default in production — enable only for private demo deployments.
DEMO_MODE=false
DEMO_EMAIL=admin@backfire.demo
DEMO_PASSWORD=Backfire-Demo-2026!
